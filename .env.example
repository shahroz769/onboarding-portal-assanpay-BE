NODE_ENV=development
APP_PORT=3000
# Runtime/API traffic. In production, use the PlanetScale PgBouncer URL (port 6432).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onboarding_portal
# Drizzle Kit and migrations. Use the direct PlanetScale URL (port 5432).
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/onboarding_portal
# Postgres.js client pool settings. These connections sit in front of PgBouncer
# when DATABASE_URL points to a Neon or PlanetScale pooled endpoint.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
# Durable case-flow worker. Failed jobs use bounded exponential backoff and
# remain visible in /health/db after the final attempt. Empty-queue polls
# back off up to CASE_FLOW_WORKER_IDLE_POLL_MS; new jobs wake the worker.
# MAX_ATTEMPTS marks a job degraded; it still retries automatically at the
# bounded RETRY_MAX_MS interval until it succeeds.
CASE_FLOW_WORKER_POLL_MS=1000
CASE_FLOW_WORKER_IDLE_POLL_MS=60000
CASE_FLOW_WORKER_BATCH_SIZE=5
CASE_FLOW_WORKER_MAX_ATTEMPTS=8
CASE_FLOW_WORKER_RETRY_BASE_MS=30000
CASE_FLOW_WORKER_RETRY_MAX_MS=900000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ALLOW_SUPER_ADMIN_REGISTRATION=false
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173,https://onboarding-portal-assanpay.shahrozahmed.workers.dev
# Enable only when the API is behind a trusted proxy that overwrites
# CF-Connecting-IP or X-Forwarded-For.
TRUST_PROXY_HEADERS=false
EMAIL_FROM="AssanPay Onboarding <onboarding@tech.assanpaybd.com>"
PUBLIC_APP_URL=http://localhost:5173
# For separate hosted frontend/backend origins over HTTPS, use:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=api.example.com
# GOOGLE_DRIVE_CLIENT_EMAIL=service-account@project-id.iam.gserviceaccount.com
# GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_PARENT_FOLDER_ID=your-google-drive-folder-id
# GOOGLE_DRIVE_PARENT_FOLDER_ID_PUBLIC=your-public-google-drive-folder-id
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_REPLY_TO=support@tech.assanpaybd.com
# EMAIL_TEST_TO=your-test-inbox@example.com
